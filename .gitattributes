# Normalize line endings: store all text as LF in the repo, let git convert
# to the platform-native line ending on checkout. Same effect as
# core.autocrlf=true but enforced at the repo level regardless of each user's
# local git config.
* text=auto

# Windows batch and PowerShell files must keep CRLF or Windows will mangle them.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary file types — never touch line endings.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.docx binary
*.db binary
