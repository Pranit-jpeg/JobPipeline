# Copy this file to .env and fill in your values.
# .env is never committed to git.

# ── Required ─────────────────────────────────────────────────────────────────

# Anthropic API key — used by the scorer (Claude Haiku) and the optional
# application generator (Claude Sonnet + Opus). Get one at:
#   https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your_key_here


# ── Optional ─────────────────────────────────────────────────────────────────

# USAJobs API credentials — only needed if you re-enable scrapers/usajobs.py
# in scrapers/run_all.py (it is disabled by default because most US federal
# roles require citizenship). Free key at https://developer.usajobs.gov/.
# The email is sent as the User-Agent per USAJobs API terms and must be a real
# address you control — USAJobs will reject generic placeholders.
USAJOBS_API_KEY=your_key_here
USAJOBS_EMAIL=your_email@example.com
